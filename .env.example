# Discord auth (optional, not required for public clients)
# MARGA_DISCORD_CLIENT_SECRET=your-discord-client-secret-here
# MARGA_DISCORD_CLIENT_ID=your-discord-client-id

# Server endpoints
# MARGA_WEBSOCKET_URL=ws://localhost:8080/ws          # local dev
# MARGA_RELAY_URL=http://localhost:8080               # local dev
# MARGA_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Web setup wizard URL
# MARGA_WEB_SETUP_URL=http://localhost:3000           # local dev
# MARGA_WEB_SETUP_URL=https://marga.kunthive.com     # production (default)
