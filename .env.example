# Marga environment overrides. Copy to .env (auto-loaded on startup).
# Marga ships no hosted relay or shared Discord app — supply your own below.

# Discord auth — register your OWN app at https://discord.com/developers
# MARGA_DISCORD_CLIENT_ID=your-discord-client-id          # required for Discord
# MARGA_DISCORD_CLIENT_SECRET=your-discord-client-secret  # only for confidential clients

# Relay endpoints — point these at a relay you run (required for Discord)
# MARGA_WEBSOCKET_URL=ws://localhost:8080/ws
# MARGA_RELAY_URL=http://localhost:8080
# MARGA_WEBHOOK_URL=https://discord.com/api/webhooks/...
# MARGA_RELAY_API_KEY=match-your-relays-API_KEY

# Web setup wizard URL — leave unset unless you host the wizard yourself.
# (The web-setup path sends your Discord token to this host.)
# MARGA_WEB_SETUP_URL=http://localhost:3000

# Matrix — no relay needed. Configure the [[networks]] block in config.toml,
# then provide your password once on first login (token is cached afterwards).
# MARGA_MATRIX_PASSWORD=your-matrix-password
